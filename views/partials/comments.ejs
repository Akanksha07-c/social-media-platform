<div class="mt-4 bg-gray-50 rounded-xl p-4 border border-gray-200">


<h4 class="text-lg font-semibold text-gray-800 mb-3">
    Comments
</h4>

<div class="comments-list flex flex-col gap-3">
    <!-- JavaScript puts comments here -->
</div>

<form action="/comment/<%= post._id %>"
      method="POST"
      class="flex flex-col sm:flex-row gap-2 mt-4">

    <input type="text" name="content" placeholder="Write a comment" required class="flex-1 border border-gray-300 rounded-lg px-4 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200">
<button type="submit" class="bg-blue-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-700 transition">
        Comment
    </button>

</form>


</div>
