<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/stylesheet/output.css">

    <title>Upload Image</title>

</head>

<body class="min-h-screen bg-gray-100 flex items-center justify-center px-4 py-8">

    <div class="w-full max-w-md bg-white rounded-2xl shadow-lg p-6 sm:p-8">

        <div class="text-center mb-6">

            <h1 class="text-3xl sm:text-4xl font-bold text-blue-600">
                Upload Image
            </h1>

            <p class="text-gray-500 mt-2">
                Choose an image to upload
            </p>

        </div>

        <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data"
            class="flex flex-col gap-4">

            <div>

                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Select Image
                </label>

                <input type="file" name="image"
                    class="w-full border border-gray-300 rounded-lg p-2 bg-white cursor-pointer
                    file:bg-blue-600 file:text-white file:border-0
                    file:px-4 file:py-2 file:mr-3 file:rounded-md
                    file:font-medium file:cursor-pointer
                    hover:file:bg-blue-700 transition">

            </div>

            <input type="submit" value="Upload File"
                class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold cursor-pointer hover:bg-blue-700 transition">

        </form>

        <a href="/profile"
            class="block text-center mt-4 text-gray-600 hover:text-blue-600 hover:underline">
            Cancel
        </a>

    </div>

</body>

</html>